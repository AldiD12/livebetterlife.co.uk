# LiveBetterLife .htaccess - Optimized for React SPA & Local SEO
RewriteEngine On
Options -Indexes +FollowSymLinks

# ==========================================
# 1. FORCE HTTPS & NON-WWW (single redirect)
# ==========================================
# Handles http→https AND www→non-www in one redirect (no double hop)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://livebetterlife.co.uk/$1 [R=301,L]

# ==========================================
# 2. GHOST URL REDIRECTS
# ==========================================
# These URLs appear in Google's index but don't exist as routes.
# Without redirects, they serve the empty SPA shell = soft 404s.

# Old portfolio shorthand URLs → actual portfolio slugs
RewriteRule ^portfolio/HA3/?$ /portfolio/ground-floor-renovation-kenton-harrow-ha3 [R=301,L]
RewriteRule ^portfolio/NW9/?$ /portfolio/house-conversion-flats-kingsbury-nw9 [R=301,L]
RewriteRule ^portfolio/W14/?$ /portfolio/luxury-renovation-russell-gardens-mews-kensington-w14 [R=301,L]
RewriteRule ^portfolio/W1K/?$ /portfolio/luxury-office-renovation-mayfair-w1k [R=301,L]
RewriteRule ^portfolio/NW6-Tennyson/?$ /portfolio/victorian-house-renovation-tennyson-road-nw6 [R=301,L]

# Old page names → best matching current pages
RewriteRule ^areas/?$ /services [R=301,L]
RewriteRule ^faq/?$ / [R=301,L]
RewriteRule ^about/?$ / [R=301,L]

# Service URL variants that don't match current routes
RewriteRule ^services/kitchen-renovation-london/?$ /services/complete-kitchen-renovation-london [R=301,L]
RewriteRule ^services/home-extension-london/?$ /services/house-extensions-london [R=301,L]

# Old portfolio redirects (keeping these - they map old names to new slugs)
RewriteRule ^portfolio/kingsbury-conversion/?$ /portfolio/house-conversion-flats-kingsbury-nw9 [R=301,L]
RewriteRule ^portfolio/brondesbury-flat/?$ /portfolio/victorian-flat-renovation-brondesbury-nw6 [R=301,L]
RewriteRule ^portfolio/russell-gardens/?$ /portfolio/luxury-renovation-russell-gardens-mews-kensington-w14 [R=301,L]
RewriteRule ^portfolio/tennyson-road/?$ /portfolio/victorian-house-renovation-tennyson-road-nw6 [R=301,L]
RewriteRule ^portfolio/davies-street/?$ /portfolio/luxury-office-renovation-mayfair-w1k [R=301,L]
RewriteRule ^portfolio/kenton-lane/?$ /portfolio/ground-floor-renovation-kenton-harrow-ha3 [R=301,L]

# ==========================================
# 3. REACT ROUTER SPA ROUTING
# ==========================================
# If the file exists (including pre-rendered HTML), serve it directly.
# Otherwise, serve index.html for client-side routing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/images/
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !\.xml$
RewriteCond %{REQUEST_URI} !\.txt$
RewriteCond %{REQUEST_URI} !\.ico$
RewriteRule . /index.html [L]

# ==========================================
# 4. SECURITY HEADERS
# ==========================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
</IfModule>

# ==========================================
# 5. COMPRESSION & CACHING
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ==========================================
# 6. FILE SECURITY
# ==========================================
<FilesMatch "^(\.htaccess|\.env|\.git|\.DS_Store|wp-config\.php|php\.ini)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(bak|config|sql|log|sh|inc|swp|dist|old|original|save|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>
